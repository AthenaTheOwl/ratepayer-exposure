---
import {
  COST_ALLOCATION,
  PJM_LDA_RATES,
  VALID_YEARS,
  ZIP_TO_LDA,
  type LdaCode,
} from "../lib/bill_delta";

const years = [...VALID_YEARS];
const ldas: LdaCode[] = ["DOM", "COMED"];

type Assumption = {
  name: string;
  value: string;
  tag: "conservative" | "median" | "upper-bound";
  basis: string;
  source_url: string;
  last_verified: string;
};

// tags per DEC-002, which supersedes the DEC-001 calibration.
const PLC_TAG: Record<LdaCode, Assumption["tag"]> = {
  DOM: "median",
  COMED: "upper-bound",
};

const PLC_NOTE: Record<LdaCode, string> = {
  DOM: "no published Dominion residential PLC found, so this value is unanchored; tagged median only because no direction of bias is established (DEC-002), not as the central value of published estimates.",
  COMED:
    "ComEd's published ~$10.60/month residential increase from the 2025/26 auction implies ~1.45 kW, so this runs high.",
};

function assumptionsFor(lda: LdaCode): Assumption[] {
  const c = COST_ALLOCATION[lda];
  const kwh = c.typical_residential_kwh_per_year;
  return [
    {
      name: `household_plc_mw (${lda})`,
      value: `${c.household_plc_mw} MW (${(c.household_plc_mw * 1000).toFixed(1)} kW)`,
      tag: PLC_TAG[lda],
      basis:
        `assumption: ${kwh.toLocaleString("en-US")} kWh ÷ 8,760 h ÷ 0.5 ` +
        `assumed load factor at PJM's five summer coincident peaks. ` +
        PLC_NOTE[lda],
      source_url: c.household_plc_source_url,
      last_verified: c.last_verified,
    },
    {
      name: `data_center_load_share (${lda})`,
      value: c.data_center_load_share.toString(),
      tag: "conservative",
      basis:
        "assumption, not a published figure. the PJM market monitor " +
        "attributes $7.27B of $16.12B (45.1%) of 2026/27 BRA revenues " +
        "to data-center load; this share sits well below that.",
      source_url: c.data_center_load_share_source_url,
      last_verified: c.last_verified,
    },
    {
      name: `typical_residential_kwh_per_year (${lda})`,
      value: kwh.toLocaleString("en-US") + " kWh",
      tag: "median",
      basis: "EIA Table 5A, 2024: average monthly consumption × 12.",
      source_url: c.source_url,
      last_verified: c.last_verified,
    },
    {
      name: `baseline_usd_per_year (${lda})`,
      value: "$" + c.baseline_usd_per_year.toFixed(2),
      tag: "median",
      basis: "EIA Table 5A, 2024: average monthly bill × 12.",
      source_url: c.source_url,
      last_verified: c.last_verified,
    },
  ];
}

const assumptions: Assumption[] = ldas.flatMap(assumptionsFor);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>methodology — ratepayer exposure</title>
    <style>
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
        max-width: 48rem;
        margin: 2rem auto;
        padding: 0 1rem;
        line-height: 1.5;
        color: #111;
      }
      h1, h2 { font-weight: 600; }
      h1 { font-size: 1.5rem; }
      h2 { font-size: 1.15rem; margin-top: 2rem; }
      pre {
        background: #f4f4f4;
        padding: 0.75rem 1rem;
        overflow-x: auto;
        font-size: 0.95rem;
        border-radius: 4px;
      }
      table { border-collapse: collapse; width: 100%; margin-top: 0.5rem; }
      th, td {
        border: 1px solid #ccc;
        padding: 0.4rem 0.6rem;
        text-align: left;
        font-size: 0.9rem;
        vertical-align: top;
      }
      th { background: #f0f0f0; }
      .tag {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        border-radius: 3px;
        font-size: 0.8rem;
        font-weight: 600;
      }
      .tag.conservative { background: #cfe; color: #053; }
      .tag.median { background: #def; color: #035; }
      .tag.upper-bound { background: #fec; color: #530; }
      .deferred li { margin: 0.25rem 0; }
      nav { font-size: 0.875rem; margin-bottom: 1.5rem; }
      a { color: #225; }
    </style>
  </head>
  <body>
    <nav><a href="/calculator/">calculator</a></nav>
    <h1>methodology</h1>
    <p>
      this page exists so a skeptical reader can audit every number the
      calculator emits. the formula is below; every input value is
      tabled with a tag (conservative / median / upper-bound) and a
      source URL.
    </p>

    <h2>formula</h2>
    <pre>delta_usd(zone, year) =
    capacity_price_delta_usd_per_mw_day(zone, year)   # USD / MW-day
  * 365                                               # day / year
  * household_plc_mw(zone)                            # MW
  * data_center_load_share(zone)                      # dimensionless
                                                      # = USD / year

baseline_usd(zone) = static field on the cost_allocation record
</pre>
    <p>
      a capacity price is charged per MW of capacity obligation. PJM
      bills a load-serving entity its daily unforced capacity
      obligation (MW, built from its customers' peak load contributions,
      or PLC) times the zonal capacity price
      (<a href="https://www.pjm.com/-/media/DotCom/documents/manuals/m18.ashx" rel="noopener">PJM Manual 18</a>).
      the household's PLC is the MW term above. price × 365 × PLC is the
      household's whole capacity-charge change; the data-center share is
      a slice of it, so the calculator's figure can never exceed it.
    </p>
    <p>
      an earlier version (DEC-001) multiplied the price by annual kWh ÷
      1000 and by a 0.04 "residential allocation share". kWh is energy,
      so the result was not a capacity charge: it put the 2030 Richmond
      figure at $2,248 a year, about 20 times the household's whole
      capacity-charge change at that price. a per-customer PLC already
      carries the residential class's allocation, so the residential
      share is gone. DEC-002 records the change.
    </p>
    <p>
      see <code>src/lib/bill_delta.ts</code> for the implementation.
      a vitest suite (<code>src/lib/bill_delta.test.ts</code>) pins
      three reference cases (low / median / upper) against
      hand-computed values, plus unit checks: annual kWh must not move
      the result, and the result must stay under price × 365 × PLC.
    </p>

    <h2>v0.2 coverage</h2>
    <p>
      two PJM LDA zones, each keyed by one ZIP-3 prefix:
      {Object.entries(ZIP_TO_LDA)
        .map(([prefix, lda]) => `${prefix} → ${lda}`)
        .join(", ")}. every other ZIP returns the sentinel "outside v0.2
      coverage". widening each zone's ZIP footprint lands in spec 0004;
      more PJM zones in spec 0005.
    </p>

    <h2>assumptions (DEC-001 charter, DEC-002 and DEC-003 revisions)</h2>
    <p>
      every assumption used by <code>billDelta()</code> appears in the
      table below with its tag, its basis and a source URL. the tag
      definitions live in
      <a href="https://github.com/AthenaTheOwl/ratepayer-exposure/blob/main/decisions/DEC-001-assumption-charter.md" rel="noopener">decisions/DEC-001-assumption-charter.md</a>;
      the current formula, tags and sources in
      <a href="https://github.com/AthenaTheOwl/ratepayer-exposure/blob/main/decisions/DEC-002-capacity-obligation.md" rel="noopener">decisions/DEC-002-capacity-obligation.md</a>.
    </p>
    <table>
      <thead>
        <tr>
          <th>assumption</th>
          <th>value</th>
          <th>tag</th>
          <th>basis</th>
          <th>source</th>
          <th>last verified</th>
        </tr>
      </thead>
      <tbody>
        {assumptions.map((a) => (
          <tr>
            <td><code>{a.name}</code></td>
            <td>{a.value}</td>
            <td><span class={`tag ${a.tag}`}>{a.tag}</span></td>
            <td>{a.basis}</td>
            <td><a href={a.source_url} rel="noopener">source</a></td>
            <td>{a.last_verified}</td>
          </tr>
        ))}
      </tbody>
    </table>

    {ldas.map((lda) => (
      <>
        <h2>{lda} zone capacity-price deltas, 2026-2030</h2>
        <table>
          <thead>
            <tr>
              <th>year</th>
              <th>PJM delivery year</th>
              <th>BRA price ($/MW-day)</th>
              <th>less 2024/25 baseline</th>
              <th>delta ($/MW-day)</th>
              <th>basis</th>
              <th>tag</th>
              <th>source</th>
              <th>last verified</th>
            </tr>
          </thead>
          <tbody>
            {years.map((y) => {
              const r = PJM_LDA_RATES[lda][y];
              return (
                <tr>
                  <td>{y}</td>
                  <td>{r.delivery_year}</td>
                  <td>${r.capacity_price_usd_per_mw_day.toFixed(2)}</td>
                  <td>
                    <a href={r.baseline_source_url} rel="noopener">
                      ${r.baseline_price_usd_per_mw_day.toFixed(2)}
                    </a>
                  </td>
                  <td>${r.capacity_price_delta_usd_per_mw_day.toFixed(2)}</td>
                  <td>{r.price_basis === "cleared" ? "cleared BRA price" : "assumption"}</td>
                  <td><span class={`tag ${r.tag}`}>{r.tag}</span></td>
                  <td>
                    <a href={r.source_url} rel="noopener">source</a>
                  </td>
                  <td>{r.last_verified}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </>
    ))}

    <h2>capacity prices (DEC-003)</h2>
    <p>
      year N means PJM delivery year N/N+1 (June 1, N to May 31, N+1).
      the price is the zone's Base Residual Auction resource clearing
      price; the delta subtracts the same zone's 2024/2025 BRA price,
      $28.92/MW-day, the last auction before the data-center-driven
      increase. the 2026/27, 2027/28 and 2028/29 auctions cleared at
      the price cap in every zone, DOM and ComEd included ($329.17,
      $333.44, $325.00), so both zones carry the same prices.
    </p>
    <p>
      2029 and 2030 have no auction result. 2029 uses the posted
      2029/2030 cap ($337.83), the most that auction can clear at
      (upper-bound). 2030 carries the same figure forward; the price
      collar ends with 2029/2030, and PJM's no-cap simulations of the
      last three auctions cleared at $388.57 to $776.69, so a flat
      $337.83 is tagged conservative. both are assumptions.
      the BRA price is not the final zonal price a utility pays after
      incremental auctions, and how the charge reaches a retail tariff
      is not modelled.
      <a href="https://github.com/AthenaTheOwl/ratepayer-exposure/blob/main/decisions/DEC-003-cleared-bra-prices.md" rel="noopener">DEC-003</a>
      records the change from the earlier $15-$110 fixture values.
    </p>

    <h2>sanity bound</h2>
    <p>
      <code>eval/sanity_bounds.py</code> runs the same model the
      calculator ships (it does not keep a second copy of the formula)
      and, for every covered (zone, year), asserts:
    </p>
    <ul>
      <li><code>delta_usd / baseline_usd &lt;= 2.0</code>;</li>
      <li>
        <code>delta_usd &lt;= price × 365 × household_plc_mw</code>: the
        data-center slice stays within the household's whole
        capacity-charge change;
      </li>
      <li>
        each PLC is 0.5-10 kW with an implied load factor (annual kWh ÷
        8,760 ÷ PLC kW) of 0.25-1.0, so an energy figure entered as a
        capacity figure fails;
      </li>
      <li>
        the ComEd PLC, priced at the 2025/26 ComEd change ($269.92 −
        $28.92 per MW-day), lands within 0.5x-2x of ComEd's published
        ~$10.60/month residential increase.
      </li>
    </ul>
    <p>
      a violation either means a real edge case (which must be called
      out here) or a bug (which must be fixed before the build can
      ship). CI runs it as <code>npm run check:bounds</code>.
    </p>

    <h2>what v0.1 does not cover (deferred to spec 0003+)</h2>
    <ul class="deferred">
      <li>
        automated citation gate (<code>npm run check:citations</code>) —
        every number on this page has a source by review; the build-time
        HTML scan lands in spec 0003.
      </li>
      <li>
        voice lint (<code>npm run check:voice</code>) — banned-terms
        scan lands in spec 0003.
      </li>
      <li>
        accessibility gate (<code>npm run check:a11y</code>) — axe-core
        integration lands in spec 0003.
      </li>
      <li>
        link-check on source URLs — lands with the citation gate in
        spec 0003.
      </li>
      <li>
        additional PJM zones beyond DOM and ComEd — spec 0005.
      </li>
      <li>
        ISOs beyond PJM, commercial / industrial bills — out of scope
        per <code>AGENTS.md</code>.
      </li>
    </ul>
  </body>
</html>
